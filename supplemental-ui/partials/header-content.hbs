<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item k-brand" href="{{{or site.url siteRootPath}}}" aria-label="kwenza home">
        {{!-- The concept B lockup (docs/research/brand/lockup-b-table.svg in the kwenza repo),
        inlined so it takes its colours from kwenza.css: ink is currentColor, the block is the
        accent. --}}
        <svg class="k-lockup" viewBox="0 0 156 36" width="117" height="27" aria-hidden="true" focusable="false">
          <g transform="translate(2 2)">
            <path d="M11 3.5H4.5v25H11M21 3.5h6.5v25H21" fill="none" stroke="currentColor" stroke-width="4"/>
            <rect class="k-block" x="11" y="11" width="10" height="10" rx="1"/>
          </g>
          <g transform="translate(46 6)" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linejoin="round" stroke-miterlimit="1">
            <path d="M2 0v24M13 8l-8.6 8.4M7.2 13.6L13.5 24"/>
            <path d="M17.5 8l3.6 16 3.6-12 3.6 12 3.6-16"/>
            <path d="M36.5 16h15.5a7.75 7.75 0 1 0-2.27 5.48"/>
            <path d="M57 24V8M57 14.5a6 6 0 0 1 12 0V24"/>
            <path d="M73 9.7h12L73 22.3h12.5"/>
            <circle cx="97" cy="16" r="6.3"/><path d="M104.6 8v16"/>
          </g>
        </svg>
      </a>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search the docs"{{#if page.home}} autofocus{{/if}}>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="{{{relativize '/docs/getting-started.html'}}}">Docs</a>
        <a class="navbar-item" href="{{{relativize '/docs/cli-reference.html'}}}">Reference</a>
        <a class="navbar-item" href="https://github.com/kwenza-build/kwenza">GitHub</a>
      </div>
    </div>
  </nav>
</header>
